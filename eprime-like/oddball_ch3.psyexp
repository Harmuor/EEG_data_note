        <Param val="&amp;#10;# tThisFlipGloba获取实时时间，如果这一个当前时间大于发送脉冲时间0.1秒就清零&amp;#10;# frameTolerance只是作为时间校正作用&amp;#10;if tThisFlipGlobal &gt; t_port + 0.1 - frameTolerance:&amp;#10;    port_1.setData(0)" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((tThisFlipGlobal &gt; ((t_port + 0.1) - frameTolerance))) {&amp;#10;    port_1.setData(0);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
